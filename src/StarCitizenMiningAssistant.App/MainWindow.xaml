                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <TabPanel DockPanel.Dock="Top" IsItemsHost="True" HorizontalAlignment="Center" Background="Transparent" />
                                <ContentPresenter ContentSource="SelectedContent" />
                            </DockPanel>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="FontFamily" Value="{StaticResource Lapd.FontDisplay}" />
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="Padding" Value="18,8" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Lapd.LineDim}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="8,0">
                                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Lapd.Teal}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="Signature" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TabTitle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SignatureOverlayOn}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Lapd.TealBright}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ToggleButton Style="{StaticResource OverlaySwitch}" IsChecked="{Binding SignatureOverlayOn}" />
                                </StackPanel>
                                <TextBlock Text="Signature Scanning" HorizontalAlignment="Left" Margin="0,27,0,0" FontFamily="{StaticResource Lapd.FontDisplay}" FontSize="16" Foreground="{StaticResource Lapd.Teal}" />
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Margin="0,0,0,6" FontSize="16" Text="Font size" />
                            <TextBox Width="120" Height="40" HorizontalAlignment="Left" FontSize="16"
                                     Text="{Binding SignatureOverlayFontSize, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Margin="0,16,0,6" FontSize="16" Text="Font color" />
                            <TextBox Width="180" Height="40" HorizontalAlignment="Left" FontSize="16"
                                     Text="{Binding SignatureOverlayColor, UpdateSourceTrigger=LostFocus}" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource ColorSwatch}" Tag="#FFFFFFFF" Background="#FFFFFFFF" Click="SignatureColor_Click" />
                                <Button Style="{StaticResource ColorSwatch}" Tag="#FF5FE8D2" Background="#FF5FE8D2" Click="SignatureColor_Click" />
                                <Button Style="{StaticResource ColorSwatch}" Tag="#FF3DDC7A" Background="#FF3DDC7A" Click="SignatureColor_Click" />
                                <Button Style="{StaticResource ColorSwatch}" Tag="#FFE0B03C" Background="#FFE0B03C" Click="SignatureColor_Click" />
                                <Button Style="{StaticResource ColorSwatch}" Tag="#FFE15B64" Background="#FFE15B64" Click="SignatureColor_Click" />
                                <Button Style="{StaticResource ColorSwatch}" Tag="#FFE6E8EB" Background="#FFE6E8EB" Click="SignatureColor_Click" />
                            </WrapPanel>
                            <TextBlock Margin="0,8,0,6" FontSize="16" Text="Transparency" />
