                                <Button DockPanel.Dock="Right" Content="Set" MinWidth="88" Click="CaptureRockHotkey_Click" />
                                <TextBlock VerticalAlignment="Center" FontSize="16" Text="{Binding RockOverlayHotkeyLabel}" />
                            </DockPanel>
                            <Button Margin="0,22,0,0" HorizontalAlignment="Left" FontSize="16" Content="Simplify mineral names" Click="SimplifyMineralNames_Click" />
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Lapd.TealDim}" FontSize="16" TextWrapping="Wrap"
                                       Text="Shortens long ore names in the game's english text so the scan row can show them." />
                        </StackPanel>
                    </TabItem>
                </TabControl>
                <TextBlock x:Name="OverlayHotkeyNote" Margin="0,16,0,0" FontSize="16" TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Lapd.TealDim}" FontSize="16" TextWrapping="Wrap"
                           Text="Each overlay has its own key. Using the same key turns both on and off together. The key still works while the game is in front." />
            </StackPanel>
