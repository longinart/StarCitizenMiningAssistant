                                <Button DockPanel.Dock="Right" Content="Set" MinWidth="88" Click="CaptureSignatureHotkey_Click" />
                                <TextBlock VerticalAlignment="Center" FontSize="16" Text="{Binding SignatureOverlayHotkeyLabel}" />
                            </DockPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="Rock" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TabTitle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RockOverlayOn}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Lapd.TealBright}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ToggleButton Style="{StaticResource OverlaySwitch}" IsChecked="{Binding RockOverlayOn}" />
                                </StackPanel>
                                <TextBlock Text="Rock Crackability" HorizontalAlignment="Left" Margin="0,27,0,0" FontFamily="{StaticResource Lapd.FontDisplay}" FontSize="16" Foreground="{StaticResource Lapd.Teal}" />
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Margin="0,20,0,0">
