        <ScrollViewer x:Name="AaronPage" Margin="48,28,48,50" Opacity="0" IsHitTestVisible="False"
                      RequestBringIntoView="AaronPage_BringIntoView"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center">
                <TextBlock Text="Aaron Halo Routes" FontSize="32" FontFamily="{StaticResource Lapd.FontDisplay}" Foreground="{StaticResource Lapd.TealBright}" HorizontalAlignment="Center" />
                <TextBlock Margin="0,16,0,0" FontSize="16" Foreground="{StaticResource Lapd.Teal}" TextAlignment="Center" TextWrapping="Wrap"
                           Text="All Aaron Halo routes target Band 5, the most popular mining region." />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Home location" HorizontalAlignment="Center" />
                <ComboBox Width="460" FontSize="16" HorizontalAlignment="Center"
                          ItemsSource="{Binding AaronHaloHomes}"
                          SelectedItem="{Binding SelectedAaronHaloHome}" />
                <ItemsControl Margin="0,28,0,0" ItemsSource="{Binding AaronHaloRoutes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Tag="route" Margin="0,0,0,14" Padding="16,12" BorderBrush="{StaticResource Lapd.LineDim}" BorderThickness="1"
                                    RenderTransformOrigin="0.5,0.5">
                                <Grid>
                                    <StackPanel Margin="0,0,0,40">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" FontSize="16" Foreground="{StaticResource Lapd.TealBright}" Text="{Binding RecommendedLabel}" />
                                            <TextBlock FontSize="20" Foreground="{StaticResource Lapd.TealBright}" Text="{Binding DestinationShort}" />
                                        </DockPanel>
                                        <TextBlock Margin="0,8,0,0" FontSize="16" Text="{Binding Exit}" />
                                        <TextBlock Margin="0,4,0,0" FontSize="16" Text="{Binding Margin}" />
                                        <TextBlock Margin="0,4,0,0" FontSize="16" Foreground="{StaticResource Lapd.TealDim}" Text="{Binding Note}"
                                                   Visibility="{Binding HasNote, Converter={StaticResource ShowWhenTrue}}" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="Hand" Focusable="False"
                                            PreviewMouseLeftButtonDown="ReverseRoute_Preview" Click="ReverseRoute_Click"
                                            Visibility="{Binding HasReverse, Converter={StaticResource ShowWhenTrue}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" Padding="8,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource Lapd.Teal}" StrokeThickness="1.8"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              Data="M3,12 A9,9 0 0 1 12,3 A9.7,9.7 0 0 1 18.7,5.7 L21,8 M21,3 L21,8 L16,8 M21,12 A9,9 0 0 1 12,21 A9.7,9.7 0 0 1 5.3,18.3 L3,16 M8,16 L3,16 L3,21" />
                                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="16" Text="Reverse route" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#243CB4A5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        </Grid>
        <Border HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" Panel.ZIndex="1">
            <DockPanel Margin="16,12,16,16">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Button x:Name="NavSettings" Content="Settings" Style="{StaticResource NavButton}" Click="ShowSettings_Click" />
                    <TextBlock Margin="8,6,0,0" FontFamily="{StaticResource Lapd.FontMono}" FontSize="14" Foreground="{StaticResource Lapd.TealDim}" Text="{Binding BuildLabel}" />
                </StackPanel>
                <StackPanel>
                    <Button x:Name="NavSelectShip" Content="Select ship" Style="{StaticResource NavButton}" Click="ChangeShip_Click" />
                    <Button x:Name="NavLoadout" Content="Ship loadouts" Style="{StaticResource NavButton}" Click="ShowLoadout_Click" IsEnabled="False" />
                    <Button x:Name="NavSignatures" Content="Signature tracking" Style="{StaticResource NavButton}" Click="ShowSignatures_Click" IsEnabled="False" />
                    <Button x:Name="NavOverlay" Content="Overlay Setup" Style="{StaticResource NavButton}" Click="ShowOverlaySetup_Click" IsEnabled="False" />
                    <Button x:Name="NavAaron" Content="Aaron Halo Routes" Style="{StaticResource NavButton}" Click="ShowAaron_Click" />
                    <Button x:Name="NavEquipment" Content="Mining equipment" Style="{StaticResource NavButton}" Click="ShowMiningEquipment_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
        </Grid>
        </Grid>
    <Button Panel.ZIndex="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,14" Cursor="Hand" Click="Kofi_Click" ToolTip="ko-fi.com/longinart">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <TextBlock x:Name="Label" Text="Tip on Ko-fi" FontSize="13" Foreground="{StaticResource Lapd.TealDim}" />
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Lapd.TealBright}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
    </Grid>
</Window>
