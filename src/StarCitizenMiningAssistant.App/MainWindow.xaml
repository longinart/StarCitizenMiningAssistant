                                <TextBlock Margin="0,8,0,0" FontSize="16" Foreground="{StaticResource Lapd.TealBright}" Text="{Binding Capacity}" />
                                <TextBlock Margin="0,4,0,0" FontSize="16" Foreground="{StaticResource Lapd.TealBright}" Text="{Binding Crew}" />
                                <TextBlock Margin="0,4,0,0" FontSize="16" Foreground="{StaticResource Lapd.TealBright}" Text="{Binding Price}" />
                                <TextBlock Margin="0,22,0,0" FontSize="18" Foreground="{StaticResource Lapd.Teal}" Text="Where to buy" />
                                <TextBlock Margin="0,8,0,0" FontSize="16" Foreground="#FFB7EDE2" TextWrapping="Wrap" Text="{Binding BuyLines}" />
