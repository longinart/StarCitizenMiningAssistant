<Window x:Class="StarCitizenMiningAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="460"
        Width="640"
        MinHeight="420"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#FF12161C"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding ProductName}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#FFE7EDF5" />
            <TextBlock Text="{Binding VersionText}"
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="#FFD4A24C" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,22,0,18"
                Padding="18"
                Background="#FF1C2430"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="External read-only mining assistant for Star Citizen."
                           FontSize="15"
                           Foreground="#FFE7EDF5"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,14,0,0"
                           FontSize="14"
                           Foreground="#FF9AA8B8"
                           TextWrapping="Wrap"
                           Text="This is the foundation build. Crackability, equipment profiles, screen recognition and the in-game overlay are not active yet." />
                <TextBlock Margin="0,14,0,0"
                           FontSize="14"
                           Foreground="#FF9AA8B8"
                           TextWrapping="Wrap"
                           Text="The program does not attach to the game, read its memory, send input, or change game files." />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   FontSize="12"
                   Foreground="#FF9AA8B8"
                   TextWrapping="Wrap"
                   Text="Startup is recorded in %LocalAppData%\StarCitizenMiningAssistant\logs\app.log" />
    </Grid>
</Window>
