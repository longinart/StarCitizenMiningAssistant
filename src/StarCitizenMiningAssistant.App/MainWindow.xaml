        </ScrollViewer>
        <ScrollViewer x:Name="SettingsPage" Margin="48,28,48,50" Opacity="0" IsHitTestVisible="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center">
                <TextBlock Text="Settings" FontSize="32" FontFamily="{StaticResource Lapd.FontDisplay}" Foreground="{StaticResource Lapd.TealBright}" HorizontalAlignment="Center" />
                <CheckBox Margin="0,28,0,0" HorizontalAlignment="Left" FontSize="16"
                          Content="Clicks pass through the overlay"
                          IsChecked="{Binding ClickThrough}">
                    <CheckBox.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="16" TextWrapping="Wrap" />
                        </DataTemplate>
                    </CheckBox.ContentTemplate>
                </CheckBox>
                <CheckBox Margin="0,18,0,0" HorizontalAlignment="Left" FontSize="16"
                          Content="Log scans"
                          IsChecked="{Binding ScanLogEnabled}">
                    <CheckBox.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="16" TextWrapping="Wrap" />
                        </DataTemplate>
                    </CheckBox.ContentTemplate>
                </CheckBox>
                <TextBlock Margin="30,8,0,0" Foreground="{StaticResource Lapd.TealDim}" FontSize="16" TextWrapping="Wrap"
                           Text="While this is ticked, placed rectangles are saved with what was read. Untick to stop." />
                <TextBlock Text="Refinery &amp; pricing" Margin="0,36,0,0" FontSize="22" FontFamily="{StaticResource Lapd.FontDisplay}" Foreground="{StaticResource Lapd.Teal}" HorizontalAlignment="Left" />
                <TextBlock Margin="0,12,0,8" Foreground="#FFA7B0BA" Text="Home refinery" />
                <ComboBox Style="{StaticResource StringCombo}" Width="460" HorizontalAlignment="Left" ItemsSource="{Binding HomeRefineries}" SelectedItem="{Binding HomeRefinery}" />
                <TextBlock Margin="0,16,0,8" Foreground="#FFA7B0BA" Text="Refining method" />
                <ComboBox Style="{StaticResource StringCombo}" Width="460" HorizontalAlignment="Left" ItemsSource="{Binding RefineryMethods}" SelectedItem="{Binding RefineryMethod}" />
                <CheckBox Margin="0,18,0,0" HorizontalAlignment="Left" FontSize="16"
                          Content="Show refined SCU instead of raw SCU"
                          IsChecked="{Binding DisplayRefinedScu}">
                    <CheckBox.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="16" TextWrapping="Wrap" />
                        </DataTemplate>
                    </CheckBox.ContentTemplate>
                </CheckBox>
                <TextBlock Text="Scan areas" Margin="0,36,0,0" FontSize="22" FontFamily="{StaticResource Lapd.FontDisplay}" Foreground="{StaticResource Lapd.Teal}" HorizontalAlignment="Left" />
                <TextBlock Margin="0,12,0,0" Foreground="#FFA7B0BA" TextWrapping="Wrap"
                           Text="Choose the monitor the game is on. The signature is read from the fixed patch under the radar. If that patch is empty, the same patch is tried one step up, down, left, and right, and a tilted pill is turned level. Mass, resistance, and instability are read from a fixed patch on the scan results. If those two numbers are not in the still, the same patch is tried one step away. A composition line stays uncertain until you type it. Cargo is not read. While the overlay is open, both are read twice a second. A dark frame keeps the last number. A new signature is kept after it appears twice. A rock mass or resistance is confirmed after two identical reads, and one read stays uncertain." />
                <TextBlock Margin="0,28,0,8" Foreground="#FFA7B0BA" Text="Monitor" />
                <ComboBox x:Name="ScanMonitor" Width="460" HorizontalAlignment="Left" SelectionChanged="ScanMonitor_Changed" />
                <TextBlock x:Name="ScanMonitorNote" Margin="0,10,0,0" Foreground="#FFA7B0BA" TextWrapping="Wrap" />
                <TextBlock Margin="0,32,0,8" FontSize="18" Text="Signature" />
                <TextBlock x:Name="SignatureRegionText" Foreground="#FFA7B0BA" Text="Fixed patch under the radar. A miss also checks one step away." />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Show still" Style="{StaticResource Lapd.Button}" MinWidth="140" MinHeight="44" Margin="0,0,12,0" FontSize="13" Click="SignatureStill_Click" />
                    <Button Content="Read text" Style="{StaticResource Lapd.Button}" MinWidth="140" MinHeight="44" FontSize="13" Click="SignatureRead_Click" />
                </StackPanel>
                <Image x:Name="SignatureStill" Margin="0,14,0,0" MaxHeight="220" HorizontalAlignment="Left" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock x:Name="SignatureStillNote" Margin="0,8,0,0" Foreground="#FFA7B0BA" TextWrapping="Wrap" />
                <TextBlock x:Name="SignatureReadText" Margin="0,8,0,0" Foreground="#FFE6E8EB" TextWrapping="Wrap" />
                <TextBlock Margin="0,32,0,8" FontSize="18" Text="Scan results" />
                <TextBlock x:Name="RockRegionText" Foreground="#FFA7B0BA" Text="Fixed patch on the scan results. A miss also checks one step away." />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Show still" Style="{StaticResource Lapd.Button}" MinWidth="140" MinHeight="44" Margin="0,0,12,0" FontSize="13" Click="RockStill_Click" />
                    <Button Content="Read text" Style="{StaticResource Lapd.Button}" MinWidth="140" MinHeight="44" FontSize="13" Click="RockRead_Click" />
                </StackPanel>
                <Image x:Name="RockStill" Margin="0,14,0,0" MaxHeight="220" HorizontalAlignment="Left" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock x:Name="RockStillNote" Margin="0,8,0,0" Foreground="#FFA7B0BA" TextWrapping="Wrap" />
                <TextBlock x:Name="RockReadText" Margin="0,8,0,0" Foreground="#FFE6E8EB" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="OverlaySetupPage" Margin="48,28,48,50" Opacity="0" IsHitTestVisible="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style x:Key="OverlaySwitch" TargetType="ToggleButton">
                    <Setter Property="Width" Value="70" />
                    <Setter Property="Height" Value="26" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Track" Width="70" Height="26" CornerRadius="13" BorderBrush="{StaticResource Lapd.Line}" BorderThickness="1" Background="{StaticResource Lapd.BgDeep}">
                                    <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9" Background="#FFE6E8EB" HorizontalAlignment="Left" Margin="3,0,0,0">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="KnobShift" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Track" Property="Background" Value="{StaticResource Lapd.Teal}" />
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="46" Duration="0:0:0.16" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="TabTitle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Lapd.FontDisplay}" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="Foreground" Value="{StaticResource Lapd.TealDim}" />
                </Style>
            </ScrollViewer.Resources>
            <StackPanel MaxWidth="760" HorizontalAlignment="Center">
                <TextBlock Text="Overlay Setup" FontSize="32" FontFamily="{StaticResource Lapd.FontDisplay}" Foreground="{StaticResource Lapd.TealBright}" HorizontalAlignment="Center" />
