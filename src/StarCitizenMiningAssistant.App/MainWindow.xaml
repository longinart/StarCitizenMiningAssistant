                            <Slider Minimum="0.7" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding RockOverlayScale}" />
                            <TextBlock Margin="0,16,0,6" FontSize="16" Text="Transparency" />
                            <Slider Minimum="0.05" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding RockOverlayOpacity}" />
