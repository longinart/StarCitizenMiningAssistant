<Window x:Class="StarCitizenMiningAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StarCitizenMiningAssistant.App"
        xmlns:vm="clr-namespace:StarCitizenMiningAssistant.App.ViewModels"
        Title="{Binding WindowTitle}"
        Height="860"
        Width="820"
        MinHeight="640"
        MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="#FF12161C"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE7EDF5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,12,0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="#FF0E131A" />
            <Setter Property="Foreground" Value="#FFE7EDF5" />
            <Setter Property="BorderBrush" Value="#FF314052" />
            <Setter Property="CaretBrush" Value="#FFE7EDF5" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,12,0" />
            <Setter Property="Padding" Value="4,4" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9AA8B8" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding ProductName}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding VersionText}" Margin="0,4,0,0" Foreground="#FFD4A24C" />
            <TextBlock Text="{Binding CatalogNote}" Margin="0,6,0,0" Foreground="#FF9AA8B8" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Margin="0,12,0,0"
                   Foreground="#FF9AA8B8"
                   TextWrapping="Wrap"
                   Text="This program does not attach to the game, read its memory, send input, or change game files." />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Rock" Margin="0" />
                <UniformGrid Columns="4" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Mass kg" Margin="0" />
                        <TextBox Text="{Binding MassText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Resistance %" Margin="0" />
                        <TextBox Text="{Binding ResistanceText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Instability (optional)" Margin="0" />
                        <TextBox Text="{Binding InstabilityText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Signature (optional)" Margin="0" />
                        <TextBox Text="{Binding SignatureText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </UniformGrid>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Ship" />
                <ComboBox ItemsSource="{Binding Ships}"
                          SelectedItem="{Binding SelectedShip}"
                          DisplayMemberPath="Name" />
                <TextBlock Text="{Binding ShipNote}" Margin="0,4,0,0" Foreground="#FFD4A24C" TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Turrets}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,8,0,0"
                                    Padding="12"
                                    Background="#FF1C2430"
                                    CornerRadius="8"
                                    Visibility="{Binding IsActive, Converter={StaticResource ShowWhenTrue}}">
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right"
                                                  Content="Count this laser"
                                                  IsChecked="{Binding IsLaserOn}"
                                                  Foreground="#FFE7EDF5"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Mining head" />
                                    <ComboBox ItemsSource="{Binding Heads}"
                                              SelectedItem="{Binding SelectedHead}"
                                              DisplayMemberPath="Name" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Craft power %" />
                                    <TextBox Width="120"
                                             HorizontalAlignment="Left"
                                             Text="{Binding CraftPercentText, UpdateSourceTrigger=PropertyChanged}" />
                                    <ItemsControl ItemsSource="{Binding Slots}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Width="72"
                                                               VerticalAlignment="Center"
                                                               Foreground="#FF9AA8B8"
                                                               Text="{Binding Label}" />
                                                    <ComboBox ItemsSource="{x:Static vm:ModuleSlotEditor.ModuleChoices}"
                                                              SelectedItem="{Binding Selected}"
                                                              DisplayMemberPath="Name"
                                                              IsEnabled="{Binding IsEnabled}">
                                                        <ComboBox.ItemContainerStyle>
                                                            <Style TargetType="ComboBoxItem">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                        <Setter Property="FontStyle" Value="Italic" />
                                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.ItemContainerStyle>
                                                    </ComboBox>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Gadget" />
                <ComboBox Width="280"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding Gadgets}"
                          SelectedItem="{Binding SelectedGadget}"
                          DisplayMemberPath="Name" />

                <TextBlock Margin="0,8,0,0"
                           Foreground="#FF9AA8B8"
                           TextWrapping="Wrap"
                           Text="Extract power and inert-material values are stored on modules. This check uses laser power, resistance, instability, green zone, charge rate, and shatter." />

                <Button Margin="0,16,0,0"
                        Padding="14,8"
                        HorizontalAlignment="Left"
                        Content="Check rock"
                        Click="Check_Click" />

                <TextBlock Margin="0,16,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{Binding Verdict}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#FF9AA8B8"
                           Text="{Binding Details}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
