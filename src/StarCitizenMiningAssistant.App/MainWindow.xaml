                                    Value="{Binding SignatureOverlayOpacity}" />
                            <CheckBox Margin="0,16,0,0" HorizontalAlignment="Left" FontSize="16"
                                      Content="Show positioning preview"
                                      IsChecked="{Binding SignatureOverlayPreview}">
                                <CheckBox.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="16" />
                                    </DataTemplate>
                                </CheckBox.ContentTemplate>
                            </CheckBox>
