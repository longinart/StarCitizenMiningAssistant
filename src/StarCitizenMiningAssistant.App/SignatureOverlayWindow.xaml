<Window x:Class="StarCitizenMiningAssistant.App.SignatureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Signature"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_Drag"
        Loaded="Window_Loaded">
    <Border x:Name="Frame" Padding="8,4" Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
        <TextBlock x:Name="Line" FontFamily="Segoe UI" FontWeight="SemiBold" TextWrapping="Wrap" />
    </Border>
</Window>
