<Window x:Class="StarCitizenMiningAssistant.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StarCitizenMiningAssistant.App"
        Title="Rock details"
        Width="540"
        Height="1100"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Opacity="{Binding RockOverlayOpacity}"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="{StaticResource Lapd.FontMono}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        LocationChanged="Window_BoundsChanged"
        SizeChanged="Window_BoundsChanged">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
        <local:ScuAmountConverter x:Key="ScuAmount" />
        <Style x:Key="HudField" TargetType="TextBox">
            <Setter Property="Background" Value="#6610181C" />
            <Setter Property="Foreground" Value="#FFF4FFFB" />
            <Setter Property="BorderBrush" Value="#665FE8D2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontFamily" Value="{StaticResource Lapd.FontMono}" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="CaretBrush" Value="#FFF4FFFB" />
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#445FE8D2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#66E08A3C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HudCombo" TargetType="ComboBox" BasedOn="{StaticResource StringCombo}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="15" FontFamily="Segoe UI" Foreground="{StaticResource App.Text}" Effect="{x:Null}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#FF03070B" CornerRadius="16" ClipToBounds="True">
    <DockPanel MinWidth="315">
            <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="39" Background="#FF03070B" PreviewMouseLeftButtonDown="Caption_Drag">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" ToolTip="Close" Click="Close_Click">
                            <Grid Width="12" Height="12">
                                <Border Width="12" Height="2" Background="{StaticResource Lapd.Teal}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border Width="12" Height="2" Background="{StaticResource Lapd.Teal}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-45" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand" PreviewMouseLeftButtonDown="ToggleDetails_Click" PreviewMouseLeftButtonUp="TitleButton_Up" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" Padding="10,0,7,0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#243CB4A5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Chevron" Width="14" Height="9" Stretch="Fill" Fill="{StaticResource Lapd.Teal}"
                                  Data="M0,0 L8,8 L16,0 Z" VerticalAlignment="Center" />
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource Lapd.FontDisplay}"
                                       FontSize="13" Foreground="{StaticResource Lapd.Teal}" Text="Rock details" />
                        </StackPanel>
                    </Button>
                    <Button Margin="3,0,0,0" VerticalAlignment="Center" Cursor="Hand" PreviewMouseLeftButtonDown="ToggleComposition_Click" PreviewMouseLeftButtonUp="TitleButton_Up" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" Padding="7,0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#243CB4A5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="CompositionChevron" Width="14" Height="9" Stretch="Fill" Fill="{StaticResource Lapd.Teal}"
                                  Data="M0,0 L8,8 L16,0 Z" VerticalAlignment="Center" />
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource Lapd.FontDisplay}"
                                       FontSize="13" Foreground="{StaticResource Lapd.Teal}" Text="Composition" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                    <Border Background="Transparent" />
                </DockPanel>
            </Border>
            <Border x:Name="ActionChrome" DockPanel.Dock="Top" Background="#FF03070B" Padding="14,0,14,5">
                <StackPanel Orientation="Horizontal">
                    <Button HorizontalAlignment="Left" Cursor="Hand" Click="Calculate_Click" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" Padding="3,5">
                                    <TextBlock Text="Calculate" FontSize="13" Foreground="{StaticResource Lapd.Teal}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#243CB4A5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="RescanButton" Margin="7,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Click to rescan composition. Hold to rescan the rock too." PreviewMouseLeftButtonDown="Rescan_Down" PreviewMouseLeftButtonUp="Rescan_Up" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" Padding="3,5,3,3">
                                    <StackPanel>
                                        <TextBlock x:Name="RescanLabel" Text="Rescan" FontSize="13" Foreground="{StaticResource Lapd.Teal}" />
                                        <Border x:Name="RescanTrack" Height="3" Margin="0,3,0,0" CornerRadius="1" Background="#223C4A48" Visibility="Collapsed" ClipToBounds="True">
                                            <Border x:Name="RescanFill" HorizontalAlignment="Left" Width="0" Background="{StaticResource Lapd.Teal}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#243CB4A5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Margin="7,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Lock the composition reading" PreviewMouseLeftButtonDown="ToggleLock_Click" PreviewMouseLeftButtonUp="TitleButton_Up" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" Padding="3,5">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Lapd.Teal}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE785;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.Composition.IsLocked, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Text" Value="&#xE72E;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#243CB4A5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
            <Border x:Name="DetailsChrome" DockPanel.Dock="Top" Background="#FF03070B" Padding="17,10,17,7">
            <StackPanel x:Name="Details" Visibility="Collapsed">
                <TextBlock FontSize="14" Foreground="#FFB7EDE2" Text="Mass" />
                <TextBox Margin="0,3,0,0" Style="{StaticResource HudField}" Text="{Binding MassText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,10,0,0" FontSize="14" Foreground="#FFB7EDE2" Text="Resistance %" />
                <TextBox Margin="0,3,0,0" Style="{StaticResource HudField}" Text="{Binding ResistanceText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,10,0,0" FontSize="14" Foreground="#FFB7EDE2" Text="Instability" />
                <TextBox Margin="0,3,0,0" Style="{StaticResource HudField}" Text="{Binding InstabilityText, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Margin="0,10,0,0" Visibility="{Binding DebugMode, Converter={StaticResource ShowWhenTrue}}">
                    <TextBlock FontSize="14" Foreground="#FFB7EDE2" Text="Signature" />
                    <TextBox Margin="0,3,0,0" Style="{StaticResource HudField}" Text="{Binding SignatureText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
            </Border>
            <Border x:Name="CompositionChrome" DockPanel.Dock="Top" Background="#FF03070B" Padding="17,0,17,7">
            <StackPanel x:Name="CompositionPanel" Visibility="Collapsed">
                <Grid Margin="0,7,0,0" Width="109" HorizontalAlignment="Left">
                    <TextBox Style="{StaticResource HudField}" FontSize="17" MinHeight="34" Padding="7,5,36,5" Text="{Binding Composition.TotalScuText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,0,7,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="#88A7B0BA" Text="SCU" />
                </Grid>
                <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                <Button HorizontalAlignment="Left" Cursor="Hand" Click="AddMineral_Click" Visibility="{Binding Composition.CanAdd, Converter={StaticResource ShowWhenTrue}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Width="26" Height="26" Background="Transparent" BorderBrush="{StaticResource Lapd.Line}" BorderThickness="1" CornerRadius="7">
                                <TextBlock Text="+" FontSize="17" Foreground="{StaticResource Lapd.Teal}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Lapd.Teal}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Margin="7,0,0,0" HorizontalAlignment="Left" Cursor="Hand" Click="RemoveMineral_Click" Visibility="{Binding Composition.CanRemove, Converter={StaticResource ShowWhenTrue}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Width="26" Height="26" Background="Transparent" BorderBrush="{StaticResource Lapd.Line}" BorderThickness="1" CornerRadius="7">
                                <TextBlock Text="−" FontSize="17" Foreground="{StaticResource Lapd.Teal}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Lapd.Teal}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                </StackPanel>
                <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Composition.Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="119" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource HudCombo}" IsEditable="False" Loaded="MineralName_Loaded"
                                          ItemsSource="{Binding Options}"
                                          SelectedItem="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid Grid.Column="1" Margin="7,0,0,0">
                                    <TextBox Text="{Binding PercentText, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource HudField}">
                                                <Setter Property="FontSize" Value="14" />
                                                <Setter Property="TextAlignment" Value="Center" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                <Setter Property="Padding" Value="3,0,19,0" />
                                                <Setter Property="MinHeight" Value="31" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.Composition.IsCompositionValid, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                        <Setter Property="Background" Value="#55E15B64" />
                                                        <Setter Property="BorderBrush" Value="#FFE15B64" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource Lapd.Teal}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#FFB7EDE2" Text="%" />
                                </Grid>
                                <TextBlock Grid.Column="2" Margin="7,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16" Foreground="#FF3DDC7A" Text="{Binding ScuText, Converter={StaticResource ScuAmount}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,7,0,0" FontSize="13" Foreground="#FFE08A3C" Text="{Binding Composition.RawPrice}" />
                <TextBlock Margin="0,3,0,0" FontSize="13" Foreground="#FFE08A3C" Text="{Binding Composition.RefinedPrice}" />
                <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource Lapd.TealDim}" TextWrapping="Wrap" Text="{Binding Composition.BestTerminals}"
                           Visibility="{Binding Composition.HasBestTerminals, Converter={StaticResource ShowWhenTrue}}" />
            </StackPanel>
            </Border>
            <Grid>
            <StackPanel x:Name="CrackHost" Margin="17,10,17,20" HorizontalAlignment="Center">
                <ItemsControl x:Name="CrackList" ItemsSource="{Binding CrackRows}" HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,6,0,0" HorizontalAlignment="Center" Cursor="Hand" Click="CrackRow_Click" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" Padding="8,2">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#FFE6E8EB" TextAlignment="Center" />
                                                <TextBlock Margin="0,3,0,0" Text="{Binding Verdict}" FontSize="22" FontWeight="SemiBold"
                                                           Foreground="{Binding Brush}" TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#243CB4A5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            </Grid>
    </DockPanel>
    </Border>
</Window>
