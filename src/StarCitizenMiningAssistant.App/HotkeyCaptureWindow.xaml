<Window x:Class="StarCitizenMiningAssistant.App.HotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Press keybind"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="{StaticResource Lapd.FontMono}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ConfirmButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Lapd.FontDisplay}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource Lapd.TealBright}" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="#243CB4A5" BorderBrush="#BF96F5E2" BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3846C8B6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Lapd.TealDim}" />
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4D5AE6D0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Lapd.BgDeep}" BorderBrush="{StaticResource Lapd.Line}" BorderThickness="1" CornerRadius="16" MinWidth="460">
        <Grid Margin="28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="Prompt" Text="Press keybind" FontSize="22" FontFamily="{StaticResource Lapd.FontDisplay}"
                       Foreground="{StaticResource Lapd.TealDim}" HorizontalAlignment="Center">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.5" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
            <TextBlock x:Name="ChordText" Grid.Row="1" Margin="0,16,0,0" FontSize="28" FontFamily="{StaticResource Lapd.FontDisplay}"
                       Foreground="{StaticResource Lapd.TealBright}" HorizontalAlignment="Center" />
            <TextBlock x:Name="RejectText" Grid.Row="1" Margin="0,16,0,0" FontSize="16" Foreground="{StaticResource Lapd.TealDim}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource ConfirmButton}" Margin="0,0,12,0" IsEnabled="False" IsDefault="True" Click="Apply_Click" />
                <Button Content="Cancel" Style="{StaticResource ConfirmButton}" IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
