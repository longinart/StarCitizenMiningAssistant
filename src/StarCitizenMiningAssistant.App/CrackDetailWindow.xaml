<Window x:Class="StarCitizenMiningAssistant.App.CrackDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StarCitizenMiningAssistant.App"
        Title="Crackability"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="{StaticResource Lapd.FontMono}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
    </Window.Resources>
    <Border Background="#FF03070B" CornerRadius="16" ClipToBounds="True" MinWidth="220">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="39" Background="#FF03070B" MouseLeftButtonDown="Caption_Drag">
                <Button HorizontalAlignment="Right" Width="34" Height="34" Cursor="Hand" ToolTip="Close" Click="Close_Click" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <Grid Width="12" Height="12">
                                    <Border Width="12" Height="2" Background="{StaticResource Lapd.Teal}" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="45" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border Width="12" Height="2" Background="{StaticResource Lapd.Teal}" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="-45" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#445FE8D2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
            <StackPanel Margin="17,4,17,16" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#FFE6E8EB" TextAlignment="Center" />
                <TextBlock Margin="0,3,0,0" Text="{Binding Verdict}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{Binding Brush}" TextAlignment="Center" />
                <TextBlock Margin="0,2,0,0" Text="{Binding Boosts}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{Binding Brush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280"
                           Visibility="{Binding HasBoosts, Converter={StaticResource ShowWhenTrue}}" />
                <StackPanel Margin="0,3,0,0" Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding HasReading, Converter={StaticResource ShowWhenTrue}}">
                    <TextBlock FontSize="14" Text="{Binding PowerRatioText}" Foreground="{Binding PowerRatioBrush}" />
                    <TextBlock FontSize="14" Text="{Binding ThrottleText}" Foreground="#FFA7B0BA" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
