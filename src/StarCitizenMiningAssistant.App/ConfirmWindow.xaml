<Window x:Class="StarCitizenMiningAssistant.App.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete loadout"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="{StaticResource Lapd.FontMono}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ConfirmButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Lapd.FontDisplay}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource Lapd.TealBright}" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="#243CB4A5" BorderBrush="#BF96F5E2" BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3846C8B6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4D5AE6D0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Lapd.BgDeep}" BorderBrush="{StaticResource Lapd.Line}" BorderThickness="1" CornerRadius="16" MinWidth="460">
        <Grid Margin="28,22,22,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="40" Height="40" Cursor="Hand" Panel.ZIndex="1" Click="No_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <Grid Width="16" Height="16">
                                <Border Width="16" Height="2.5" Background="{StaticResource Lapd.Teal}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border Width="16" Height="2.5" Background="{StaticResource Lapd.Teal}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-45" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#445FE8D2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Text="Delete loadout" FontFamily="{StaticResource Lapd.FontDisplay}" FontSize="22" Foreground="{StaticResource Lapd.TealBright}" HorizontalAlignment="Center" IsHitTestVisible="False" />
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="24,18,24,0" FontSize="16" Foreground="{StaticResource Lapd.Teal}" TextAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                <Button Content="Yes" Style="{StaticResource ConfirmButton}" Margin="0,0,12,0" IsDefault="True" Click="Yes_Click" />
                <Button Content="No" Style="{StaticResource ConfirmButton}" IsCancel="True" Click="No_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
